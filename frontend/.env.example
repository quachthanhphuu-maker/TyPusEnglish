# PostgreSQL connection used only by the server-side Prisma client.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Generate a unique random value with `openssl rand -base64 32`.
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Local development can use Mailpit's SMTP listener (127.0.0.1:1025).
# Production must set credentials for an approved SMTP provider.
AUTH_EMAIL_SERVER=smtp://SMTP_USER:SMTP_PASSWORD@SMTP_HOST:587
AUTH_EMAIL_FROM=TyPusEnglish <no-reply@example.com>

