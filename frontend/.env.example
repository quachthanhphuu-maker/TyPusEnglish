# PostgreSQL connection used only by the server-side Prisma client.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Generate a unique random value with `openssl rand -base64 32`.
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Gmail API sender. Create a separate Google OAuth Web client for this mailbox.
# Register http://127.0.0.1:8787/oauth2callback as an authorized redirect URI.
# Add the sender account as an OAuth test user while the app is in Testing.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER_EMAIL=
# Run `pnpm gmail:connect` from frontend to authorize and store this token locally.
GMAIL_REFRESH_TOKEN=

# Google OAuth (server-only). Create a Google OAuth web client and set the
# authorized callback URL to ${NEXTAUTH_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zalo OAuth (server-only). Register ${NEXTAUTH_URL}/api/auth/callback/zalo
# as the Zalo app callback URL; the secret is sent only from the server.
ZALO_APP_ID=
ZALO_APP_SECRET=

